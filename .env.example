# Copy to .env in the repository root. Defaults need no Docker or model keys.
SLIDEMIND_DATABASE_URL=sqlite:///./data/slidemind.db
SLIDEMIND_STORAGE_BACKEND=local
SLIDEMIND_STORAGE_ROOT=./data/storage
SLIDEMIND_MAX_UPLOAD_MB=25
SLIDEMIND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local single-user clearance: server policy, never supplied by a request.
SLIDEMIND_SECURITY_CLEARANCE=CONFIDENTIAL
SLIDEMIND_MINIO_ENDPOINT=localhost:9000
SLIDEMIND_MINIO_ACCESS_KEY=slidemind
SLIDEMIND_MINIO_SECRET_KEY=slidemind-local-development
SLIDEMIND_MINIO_BUCKET=ppt
SLIDEMIND_MINIO_SECURE=false
SLIDEMIND_RENDERER_URL=http://127.0.0.1:3001
SLIDEMIND_RENDERER_TIMEOUT_SECONDS=60

# Phase 2 model services. Use local for FastEmbed; http for your internal service.
SLIDEMIND_EMBEDDING_PROVIDER=http
SLIDEMIND_EMBEDDING_URL=http://172.16.1.212:6068/v1/embeddings
SLIDEMIND_EMBEDDING_MODEL=qwen3_embedding
SLIDEMIND_EMBEDDING_DIMENSIONS=1024
SLIDEMIND_EMBEDDING_REVISION=
SLIDEMIND_EMBEDDING_API_KEY=
SLIDEMIND_EMBEDDING_TIMEOUT_SECONDS=30
SLIDEMIND_EMBEDDING_QUERY_INSTRUCTION="Given a query, retrieve relevant passages that answer the query"
SLIDEMIND_RETRIEVAL_MIN_SIMILARITY=0.4
SLIDEMIND_RERANKER_URL=http://172.16.1.212:6066/v1/rerank
SLIDEMIND_RERANKER_MODEL=qwen3_reranker
# qwen3 adds the judgement prompt required by this paired-scoring service.
# Use plain if the server already applies its own Qwen3 chat template.
SLIDEMIND_RERANKER_INPUT_FORMAT=qwen3
SLIDEMIND_RERANKER_API_KEY=
SLIDEMIND_RERANKER_TIMEOUT_SECONDS=10
SLIDEMIND_RERANKER_MIN_SCORE=0.05
SLIDEMIND_INGESTION_ENABLED=true
SLIDEMIND_INGESTION_POLL_SECONDS=1
SLIDEMIND_INGESTION_LEASE_SECONDS=120
SLIDEMIND_CHUNK_SIZE=400
# Local alternative: provider=local, model=BAAI/bge-small-zh-v1.5,
# retrieval_min_similarity=0.5; unset reranker_url if not using reranking.
SLIDEMIND_EMBEDDING_CACHE_DIR=./.cache/fastembed
SLIDEMIND_EMBEDDING_THREADS=2
# Docker infrastructure:
# SLIDEMIND_DATABASE_URL=postgresql+psycopg://slidemind:slidemind@localhost:5432/slidemind
# SLIDEMIND_STORAGE_BACKEND=minio
# Existing internal infrastructure (provide credentials in your ignored .env):
# SLIDEMIND_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@172.16.1.212:15432/postgres
# SLIDEMIND_STORAGE_BACKEND=minio
# SLIDEMIND_MINIO_ENDPOINT=172.16.1.212:19000
# SLIDEMIND_MINIO_ACCESS_KEY=YOUR_ACCESS_KEY
# SLIDEMIND_MINIO_SECRET_KEY=YOUR_SECRET_KEY
# SLIDEMIND_MINIO_BUCKET=slide
# SLIDEMIND_MINIO_SECURE=false
# PostgreSQL must have the pgvector server extension installed before db:migrate.
