# Copy to .env in the repository root. Defaults need no Docker or model keys.
SLIDEMIND_DATABASE_URL=sqlite:///./data/slidemind.db
SLIDEMIND_STORAGE_BACKEND=local
SLIDEMIND_STORAGE_ROOT=./data/storage
SLIDEMIND_MAX_UPLOAD_MB=25
SLIDEMIND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local single-user clearance: server policy, never supplied by a request.
SLIDEMIND_SECURITY_CLEARANCE=CONFIDENTIAL
SLIDEMIND_MINIO_ENDPOINT=localhost:9000
SLIDEMIND_MINIO_ACCESS_KEY=slidemind
SLIDEMIND_MINIO_SECRET_KEY=slidemind-local-development
SLIDEMIND_MINIO_BUCKET=ppt
SLIDEMIND_MINIO_SECURE=false
SLIDEMIND_RENDERER_URL=http://127.0.0.1:3001
SLIDEMIND_RENDERER_TIMEOUT_SECONDS=60
# Docker infrastructure:
# SLIDEMIND_DATABASE_URL=postgresql+psycopg://slidemind:slidemind@localhost:5432/slidemind
# SLIDEMIND_STORAGE_BACKEND=minio
